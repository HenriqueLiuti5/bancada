# Configuração do Bancada em produção. No servidor, rode ./gerar-segredos.sh nesta pasta: ele cria
# o .env a partir deste arquivo, já com senhas e chaves novas, e você completa o resto.
#
# O .env nunca vai para o GitHub. Guarde uma cópia dele num gerenciador de senhas, longe do
# servidor e do backup: sem a BANCADA_ENCRYPTION_KEY, as senhas de desbloqueio dos aparelhos que
# estão no backup ficam ilegíveis.

# Endereço do site, sem https:// nem barra no fim, como bancada.com.br. O certificado HTTPS sai
# sozinho quando o domínio já aponta para este servidor.
DOMINIO=

# Banco de dados. O superusuário só cria o banco e faz o backup; o dono das tabelas roda as
# migrações; a aplicação só lê e grava (ADR 0032).
POSTGRES_DB=bancada
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_OWNER_USER=bancada_dono
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_USER=bancada_app
POSTGRES_APP_PASSWORD=

# Chaves do sistema. A do Django assina os links das fotos e das logos; a de criptografia protege
# as senhas de desbloqueio. Uma vez em uso, a de criptografia não pode mudar.
DJANGO_SECRET_KEY=
BANCADA_ENCRYPTION_KEY=

# WhatsApp do suporte, com DDD e só os números, como 43996156781.
WHATSAPP_DO_SUPORTE=

# Medição de visitas com o Umami, num banco só dele. O ID do site sai do painel do Umami depois da
# primeira subida, como explica o README; em branco, o site não conta visitas.
UMAMI_POSTGRES_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_ID_DO_SITE=

# Asaas de produção: a chave sai em Integrações → Chaves de API, na conta de produção, e vai
# entre aspas simples, porque começa com $. O token do webhook é o mesmo cadastrado no Asaas.
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
VALOR_DA_ASSINATURA=59.90

# E-mail, pelo provedor escolhido, com o domínio verificado nele.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Fotos e logos num armazenamento compatível com S3. Opcional: em branco, elas ficam no disco do
# servidor e entram no backup de lá. S3_ADDRESSING_STYLE=path só se o provedor pedir.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=

# Monitoramento de erros. Opcional: o endereço (DSN) vem do projeto criado no Sentry ou em outro
# serviço compatível, como o GlitchTip.
SENTRY_DSN=

# Backup diário, a partir desta hora (horário de Brasília). Com o destino em branco, as cópias
# ficam só neste servidor, e o log avisa todo dia.
HORA_DO_BACKUP=3
# Destino externo, num armazenamento compatível com S3 e de preferência em outro provedor.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Senha que criptografa o backup externo. Sem ela, não há como ler as cópias.
BACKUP_SENHA=
# Endereço chamado a cada backup concluído, para um serviço de monitoramento avisar quando ele
# faltar (healthchecks.io, Better Stack, Uptime Kuma).
AVISO_DO_BACKUP_URL=
